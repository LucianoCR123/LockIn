generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  country      String? // ISO alpha-2, ej. "CA"
  city         String?
  timezone     String? // IANA, ej. "America/Toronto"
  lastReminderDate String? // "YYYY-MM-DD" en su huso, evita duplicar el aviso de las 9pm
  createdAt    DateTime @default(now())

  memberships       GroupMembership[]
  logs              DailyLog[]
  createdGroups     Group[]             @relation("GroupsCreated")
  cheersSent        Cheer[]             @relation("CheersSent")
  cheersRecv        Cheer[]             @relation("CheersReceived")
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Group {
  id                String   @id @default(cuid())
  name              String
  inviteCode        String   @unique
  createdById       String
  minDailySteps     Int      @default(10000)
  minWeeklyWorkouts Int      @default(5)
  shitMealsPerWeek  Int      @default(1)
  shitDaysPerMonth  Int      @default(0)
  createdAt         DateTime @default(now())

  createdBy   User              @relation("GroupsCreated", fields: [createdById], references: [id])
  memberships GroupMembership[]
  cheers      Cheer[]
}

model GroupMembership {
  id              String    @id @default(cuid())
  userId          String
  groupId         String
  joinedAt        DateTime  @default(now())
  acceptedRulesAt DateTime?

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

// Un registro por usuario por dia, compartido entre todos sus grupos.
model DailyLog {
  id           String   @id @default(cuid())
  userId       String
  date         String // "YYYY-MM-DD"
  steps        Int      @default(0)
  workoutDone  Boolean  @default(false)
  dietOk       Boolean  @default(false)
  usedShitMeal Boolean  @default(false)
  usedShitDay  Boolean  @default(false)
  note         String?
  photoUrl     String? // prueba opcional (Cloudinary)
  // A que grupos cuenta este dia. Vacio = cuenta para TODOS los grupos del
  // usuario (default, y comportamiento historico).
  groupIds     String[]
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Cheer {
  id          String   @id @default(cuid())
  groupId     String
  senderId    String
  recipientId String?
  type        String // "encouragement" | "congrats" | "custom"
  text        String
  photoUrl    String? // opcional (Cloudinary)
  createdAt   DateTime @default(now())

  group     Group @relation(fields: [groupId], references: [id])
  sender    User  @relation("CheersSent", fields: [senderId], references: [id])
  recipient User? @relation("CheersReceived", fields: [recipientId], references: [id])
}
